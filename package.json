{
  "name": "session-cost-skills",
  "version": "0.2.0",
  "private": false,
  "description": "Cline and MiniMax Code session-cost skills with shared reporting architecture",
  "type": "module",
  "scripts": {
    "sync:dashboard": "node scripts/sync-dashboard.mjs",
    "check:dashboard": "node scripts/sync-dashboard.mjs --check",
    "test": "node --test tests/dashboard-security.test.mjs adapters/cline/skill/tests/core.test.mjs adapters/cline/skill/tests/account.test.mjs adapters/mcode/skill/tests/rates.test.mjs adapters/mcode/skill/tests/cli.test.mjs",
    "check:cline": "node --check adapters/cline/skill/scripts/session-cost.mjs && node --check adapters/cline/skill/scripts/lib/session-cost-core.mjs && node --check adapters/cline/skill/scripts/lib/cline-account.mjs",
    "check:mcode": "node --check adapters/mcode/skill/scripts/session-cost.mjs && node --check adapters/mcode/skill/scripts/lib/dashboard.mjs && node --check adapters/mcode/skill/scripts/lib/rates.mjs",
    "verify": "npm run check:dashboard && npm run check:cline && npm run check:mcode && npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
