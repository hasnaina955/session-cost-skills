{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hasnaina955.github.io/session-cost-skills/contracts/session-config-v1.schema.json",
  "title": "Session Cost configuration v1",
  "type": "object",
  "required": ["schemaVersion", "runtimeDefaults", "providers", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "costCentres": {
      "description": "Named cost centres. A tag names a group of sessions so spend can be attributed to a project rather than only totalled.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sessionIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]{0,63}$" },
          "sessionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "runtimeDefaults": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "includeChildren": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "driverId", "match"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "driverId": { "type": "string", "minLength": 1 },
          "match": {
            "type": "object",
            "required": ["providerIds", "runtimes"],
            "properties": {
              "providerIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
              "runtimes": { "type": "array", "items": { "enum": ["cline", "mcode", "opencode"] }, "minItems": 1, "uniqueItems": true }
            },
            "additionalProperties": false
          },
          "endpointEnv": { "type": ["string", "null"] },
          "baseUrlEnv": { "type": ["string", "null"] },
          "credentialEnv": { "type": ["string", "null"] },
          "region": { "type": ["string", "null"] },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "pricingMode": { "enum": ["bundled", "network", "manual", "none"] },
          "rateSource": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": { "enum": ["manual", "imported"] },
              "url": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "rateCards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model", "effectiveFrom", "input", "output", "cacheRead", "cacheWrite"],
              "properties": {
                "model": { "type": "string", "minLength": 1 },
                "effectiveFrom": { "type": "string", "format": "date-time" },
                "effectiveThrough": { "type": ["string", "null"] },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "input": { "type": "number", "minimum": 0 },
                "output": { "type": "number", "minimum": 0 },
                "cacheRead": { "type": "number", "minimum": 0 },
                "cacheWrite": { "type": "number", "minimum": 0 },
                "context": {
                  "type": "object",
                  "required": ["minTokens", "maxTokens"],
                  "properties": {
                    "minTokens": { "type": "integer", "minimum": 0 },
                    "maxTokens": { "type": ["integer", "null"], "minimum": 0 }
                  },
                  "additionalProperties": false
                },
                "timeBand": { "enum": ["flat", "peak", "offPeak"] }
              },
              "additionalProperties": false
            }
          },
          "importedRateRecords": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model", "component", "sourceAmount", "amount", "currency", "effectiveFrom", "context", "timeBand", "source", "fingerprint"],
              "properties": {
                "model": { "type": "string", "minLength": 1 },
                "component": { "enum": ["input", "output", "cacheRead", "cacheWrite"] },
                "sourceAmount": { "type": "string", "minLength": 1 },
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "effectiveFrom": { "type": "string", "format": "date-time" },
                "effectiveThrough": { "type": ["string", "null"] },
                "context": { "type": "object", "additionalProperties": true },
                "timeBand": { "enum": ["flat", "peak", "offPeak"] },
                "source": { "type": "object", "additionalProperties": true },
                "fingerprint": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "provider", "runtimeModel", "rateModel"],
        "properties": {
          "runtime": { "enum": ["cline", "mcode"] },
          "provider": { "type": "string", "minLength": 1 },
          "runtimeModel": { "type": "string", "minLength": 1 },
          "rateModel": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
