{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hasnaina955.github.io/session-cost-skills/contracts/normalized-report-v1.schema.json",
  "title": "Session Cost normalized report v1",
  "description": "Common cross-adapter report envelope. Runtime-specific fields are allowed as extensions.",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "generatedAt",
    "runtime",
    "snapshot",
    "selection",
    "usage",
    "billing",
    "coverage",
    "sessionGraph",
    "provenance",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "selection": { "$ref": "#/$defs/selection" },
    "usage": { "$ref": "#/$defs/usage" },
    "billing": { "$ref": "#/$defs/billing" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "sessionGraph": { "$ref": "#/$defs/sessionGraph" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "session": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "models": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["id", "costBasis", "storageSource"],
      "properties": {
        "id": { "enum": ["cline", "mcode"] },
        "costBasis": { "enum": ["runtime-recorded", "provider-rate-estimate"] },
        "storageSource": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["capturedAt", "active", "state"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "state": { "type": "string", "minLength": 1 },
        "lastLedgerActivityAt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["method", "requestedId", "candidateIds", "warning"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "requestedId": { "type": ["string", "null"] },
        "candidateIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "warning": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "totalTokens",
        "inputTokens",
        "freshInputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "outputTokens",
        "cacheHitRate",
        "semantics"
      ],
      "properties": {
        "totalTokens": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "number", "minimum": 0 },
        "freshInputTokens": { "type": "number", "minimum": 0 },
        "cacheReadTokens": { "type": "number", "minimum": 0 },
        "cacheWriteTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "cacheHitRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "semantics": {
          "type": "object",
          "required": [
            "inputTokenMeaning",
            "cacheReadTokensSeparate",
            "cacheWriteTokensSeparate",
            "reasoningIncludedInOutput"
          ],
          "properties": {
            "inputTokenMeaning": { "enum": ["includes-cache", "excludes-cache"] },
            "cacheReadTokensSeparate": { "const": true },
            "cacheWriteTokensSeparate": { "const": true },
            "reasoningIncludedInOutput": { "enum": [true, false, "not-reported"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "billing": {
      "type": "object",
      "required": [
        "basis",
        "currency",
        "amountUsd",
        "recordedCostUsd",
        "estimatedCostUsd",
        "rateKnown",
        "coverage",
        "classification"
      ],
      "properties": {
        "basis": { "enum": ["runtime-recorded", "provider-rate-estimate"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "amountUsd": { "type": ["number", "null"], "minimum": 0 },
        "recordedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "rateKnown": { "type": "boolean" },
        "coverage": { "enum": ["complete", "partial", "unavailable", "no-calls", "not-recorded", "unknown"] },
        "classification": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["status", "calls", "totalTokens", "unknownReasons"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable", "no-calls", "not-recorded", "unknown"] },
        "calls": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "unknownReasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sessionGraph": {
      "type": "object",
      "required": [
        "rootSessionIds",
        "includedSessionIds",
        "excludedSessionIds",
        "duplicateSuppressedSessionIds"
      ],
      "properties": {
        "rootSessionIds": { "$ref": "#/$defs/sessionIds" },
        "includedSessionIds": { "$ref": "#/$defs/sessionIds" },
        "excludedSessionIds": { "$ref": "#/$defs/sessionIds" },
        "duplicateSuppressedSessionIds": { "$ref": "#/$defs/sessionIds" }
      },
      "additionalProperties": false
    },
    "sessionIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source", "rateSources"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "rateSources": { "$ref": "#/$defs/sessionIds" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
